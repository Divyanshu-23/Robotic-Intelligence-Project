<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="warehouse">
    <physics name="1ms" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Essential Gazebo Harmonic Simulation Systems -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <!-- Lighting & Sun -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.85 0.85 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <scene>
      <ambient>0.6 0.6 0.6 1.0</ambient>
      <background>0.85 0.88 0.92 1.0</background>
      <grid>true</grid>
    </scene>

    <!-- Ground Floor -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>50 50</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 30</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.82 0.82 0.82 1</ambient>
            <diffuse>0.82 0.82 0.82 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Perimeter Walls (16m x 14m Warehouse) -->
    <!-- North Wall -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 7.0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>16.2 0.2 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>16.2 0.2 2.5</size></box></geometry>
          <material>
            <ambient>0.3 0.35 0.4 1</ambient>
            <diffuse>0.3 0.35 0.4 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- South Wall -->
    <model name="wall_south">
      <static>true</static>
      <pose>0 -7.0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>16.2 0.2 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>16.2 0.2 2.5</size></box></geometry>
          <material>
            <ambient>0.3 0.35 0.4 1</ambient>
            <diffuse>0.3 0.35 0.4 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- East Wall -->
    <model name="wall_east">
      <static>true</static>
      <pose>8.0 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 14.0 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 14.0 2.5</size></box></geometry>
          <material>
            <ambient>0.3 0.35 0.4 1</ambient>
            <diffuse>0.3 0.35 0.4 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- West Wall -->
    <model name="wall_west">
      <static>true</static>
      <pose>-8.0 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 14.0 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 14.0 2.5</size></box></geometry>
          <material>
            <ambient>0.3 0.35 0.4 1</ambient>
            <diffuse>0.3 0.35 0.4 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Warehouse Storage Shelves (Aisle A, B, C) -->
    <!-- Shelf Row A1 -->
    <model name="shelf_a1">
      <static>true</static>
      <pose>-2.5 3.5 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>4.5 0.8 2.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>4.5 0.8 2.0</size></box></geometry>
          <material>
            <ambient>0.15 0.25 0.5 1</ambient>
            <diffuse>0.2 0.35 0.65 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Shelf Row A2 -->
    <model name="shelf_a2">
      <static>true</static>
      <pose>3.5 3.5 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>4.5 0.8 2.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>4.5 0.8 2.0</size></box></geometry>
          <material>
            <ambient>0.15 0.25 0.5 1</ambient>
            <diffuse>0.2 0.35 0.65 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Shelf Row B1 -->
    <model name="shelf_b1">
      <static>true</static>
      <pose>-2.5 0.0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>4.5 0.8 2.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>4.5 0.8 2.0</size></box></geometry>
          <material>
            <ambient>0.15 0.25 0.5 1</ambient>
            <diffuse>0.2 0.35 0.65 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Shelf Row B2 -->
    <model name="shelf_b2">
      <static>true</static>
      <pose>3.5 0.0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>4.5 0.8 2.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>4.5 0.8 2.0</size></box></geometry>
          <material>
            <ambient>0.15 0.25 0.5 1</ambient>
            <diffuse>0.2 0.35 0.65 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Shelf Row C1 -->
    <model name="shelf_c1">
      <static>true</static>
      <pose>-2.5 -3.5 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>4.5 0.8 2.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>4.5 0.8 2.0</size></box></geometry>
          <material>
            <ambient>0.15 0.25 0.5 1</ambient>
            <diffuse>0.2 0.35 0.65 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Shelf Row C2 -->
    <model name="shelf_c2">
      <static>true</static>
      <pose>3.5 -3.5 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>4.5 0.8 2.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>4.5 0.8 2.0</size></box></geometry>
          <material>
            <ambient>0.15 0.25 0.5 1</ambient>
            <diffuse>0.2 0.35 0.65 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Delivery Workstations (East side) -->
    <!-- Station 1 -->
    <model name="station_1">
      <static>true</static>
      <pose>6.8 4.5 0.45 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.2 1.5 0.9</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.2 1.5 0.9</size></box></geometry>
          <material>
            <ambient>0.1 0.6 0.3 1</ambient>
            <diffuse>0.2 0.75 0.4 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Station 2 -->
    <model name="station_2">
      <static>true</static>
      <pose>6.8 0.0 0.45 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.2 1.5 0.9</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.2 1.5 0.9</size></box></geometry>
          <material>
            <ambient>0.1 0.6 0.3 1</ambient>
            <diffuse>0.2 0.75 0.4 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Station 3 -->
    <model name="station_3">
      <static>true</static>
      <pose>6.8 -4.5 0.45 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.2 1.5 0.9</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.2 1.5 0.9</size></box></geometry>
          <material>
            <ambient>0.1 0.6 0.3 1</ambient>
            <diffuse>0.2 0.75 0.4 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Charging / Home Station Pad (West side) -->
    <model name="home_dock">
      <static>true</static>
      <pose>-6.5 -5.5 0.02 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>1.5 1.5 0.04</size></box></geometry>
          <material>
            <ambient>0.9 0.5 0.1 1</ambient>
            <diffuse>0.95 0.6 0.15 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
